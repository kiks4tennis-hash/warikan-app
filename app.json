{
  "expo": {
    "name": "割り勘ノート",
    "slug": "warikan-app",
    "scheme": "warikanseisan",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kazumax71.warikanseisan"
    },
    "plugins": [
      "expo-router",
      ["expo-image-picker", { "photosPermission": "レシート画像を選択して支出を記録するために写真へのアクセスを使用します。" }]
    ],
    "experiments": { "typedRoutes": true }
  }
}

