        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6f8b94b2-7ea7-46f7-b17e-1159b4b2bac4"
      }
    },
    "owner": "kazumax71"
  }
